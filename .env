# ==============================================================================
# JAA Admin API Configuration
# Allowed endpoints:
# 1) Localhost: http://localhost:5000/api/admin
# 2) Network IP: http://192.168.1.26:5000/api/admin
# ==============================================================================

# Switch between Option 1 and Option 2 by commenting/uncommenting:
# --- OPTION 1: Localhost (Default) ---
admin_base_url="http://localhost:5000/api/admin"

# --- OPTION 2: Network IP (LAN) ---
# admin_base_url="http://192.168.1.26:5000/api/admin"

# Dedicated URL definitions for both environments:
NEXT_PUBLIC_LOCAL_ADMIN_URL="http://localhost:5000/api/admin"
NEXT_PUBLIC_IP_ADMIN_URL="http://192.168.1.26:5000/api/admin"

NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"
ADMIN_BASE_URL="${admin_base_url}"
NEXT_PUBLIC_ADMIN_BASE_URL="${admin_base_url}"

# Auth Endpoints
NEXT_PUBLIC_LOGIN_API_URL="${admin_base_url}/login"
NEXT_PUBLIC_LOGOUT_API_URL="${admin_base_url}/logout"
NEXT_PUBLIC_FORGET_PASSWORD_API_URL="${admin_base_url}/forget-password"
NEXT_PUBLIC_RESET_PASSWORD_API_URL="${admin_base_url}/reset-password"
NEXT_PUBLIC_VERIFY_RESET_TOKEN_API_URL="${admin_base_url}/verify-reset-token"
NEXT_PUBLIC_PROFILE_API_URL="${admin_base_url}/profile"
NEXT_PUBLIC_CHANGE_PASSWORD_API_URL="${admin_base_url}/change-password"

# Module Endpoints
NEXT_PUBLIC_MEMBERS_API_URL="${admin_base_url}/members"
NEXT_PUBLIC_EVENTS_API_URL="${admin_base_url}/events"
NEXT_PUBLIC_BROADCASTS_API_URL="${admin_base_url}/broadcasts"
NEXT_PUBLIC_COMMITTEE_API_URL="${admin_base_url}/committee"
NEXT_PUBLIC_COMPLAINTS_API_URL="${admin_base_url}/complaints"
NEXT_PUBLIC_GROUPS_API_URL="${admin_base_url}/groups"
NEXT_PUBLIC_LEADS_API_URL="${admin_base_url}/leads"
NEXT_PUBLIC_POSTS_API_URL="${admin_base_url}/posts"
